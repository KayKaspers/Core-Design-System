{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:github.com,2026:KayKaspers/Core-Design-System/schema/cds-resolver-document/1",
  "title": "CDS Resolver Document (v1)",
  "description": "Structural JSON Schema for a CDS Resolver/Composition document (strict JSON, .resolver.json) using DTCG 2025.10-compatible resolver concepts. Declares an explicit, reproducible ordered composition over locally declared source sets, using $ref / RFC 6901 JSON Pointer references. It does NOT verify resolvability, ordering semantics, or non-inversion of the layer direction (V3/V4). Resolver output is generated and non-normative.",
  "type": "object",
  "required": [
    "resolverVersion",
    "resolverId",
    "profileVersion",
    "dtcgReportVersion",
    "sourceRevision",
    "localOnly",
    "orderedSourceSets",
    "outputIdentity"
  ],
  "properties": {
    "resolverVersion": { "type": "string", "const": "1" },
    "resolverId": { "$ref": "#/$defs/sourceSetId" },
    "profileVersion": { "type": "string", "const": "1" },
    "dtcgReportVersion": { "type": "string", "const": "2025.10" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "localOnly": { "type": "boolean", "const": true },
    "testOnly": { "type": "boolean" },
    "nonNormative": { "type": "boolean" },
    "orderedSourceSets": {
      "type": "array",
      "minItems": 1,
      "description": "Explicit, reproducible composition order. Each step references a locally declared source set by a local $ref (optionally with an RFC 6901 JSON Pointer). Automatic source-set discovery is prohibited.",
      "items": { "$ref": "#/$defs/orderedSourceSet" }
    },
    "modifiers": {
      "type": "array",
      "description": "Optional conditional modifiers / composition steps (DTCG resolver concept). Applied in array order.",
      "items": { "$ref": "#/$defs/modifier" }
    },
    "outputIdentity": {
      "type": "object",
      "description": "Placeholder identity for the generated (non-normative) output. No real output is produced here.",
      "required": ["outputId", "generated", "digestState"],
      "properties": {
        "outputId": { "type": "string", "minLength": 1 },
        "generated": { "type": "boolean", "const": true },
        "digestState": { "$ref": "#/$defs/digestState" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceSetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$"
    },
    "localRef": {
      "type": "string",
      "pattern": "^(?!https?:|file:|//|\\\\).+$",
      "description": "Local / relative reference only; no network scheme, no absolute UNC path (DEC-S-086, DEC-S-091)."
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/(([^/~]|~0|~1)*))*$",
      "description": "An RFC 6901 JSON Pointer (may be the empty string for the whole document)."
    },
    "orderedSourceSet": {
      "type": "object",
      "required": ["order", "sourceSetId", "$ref"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "sourceSetId": { "$ref": "#/$defs/sourceSetId" },
        "$ref": { "$ref": "#/$defs/localRef" },
        "pointer": { "$ref": "#/$defs/jsonPointer" }
      },
      "additionalProperties": false
    },
    "modifier": {
      "type": "object",
      "required": ["order", "name"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/sourceSetId" },
        "$ref": { "$ref": "#/$defs/localRef" },
        "pointer": { "$ref": "#/$defs/jsonPointer" }
      },
      "additionalProperties": false
    },
    "digestState": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Not computed – validator implementation pending", "Computed"]
        },
        "canonicalizationMethod": { "type": "string" },
        "digestAlgorithm": { "type": "string" },
        "contentDigest": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
